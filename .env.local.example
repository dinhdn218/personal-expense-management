# Sao chép file này thành .env.local rồi điền giá trị thật.
# Hướng dẫn lấy từng giá trị: supabase/README.md

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>

# CHỈ dùng cho test E2E. Key này BỎ QUA MỌI RLS — đọc ghi được dữ liệu của mọi
# tài khoản. Không bao giờ đặt tiền tố NEXT_PUBLIC_ cho nó, và không import vào
# bất cứ file nào trong app/ hay components/.
# Trỏ vào project Supabase RIÊNG cho test: seeder xoá sạch dữ liệu trước mỗi lần chạy.
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key>
